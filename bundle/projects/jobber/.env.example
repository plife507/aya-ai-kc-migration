# Jobber API Configuration
# Copy to .env and fill in values: cp .env.example .env

# === Required ===
JOBBER_ACCESS_TOKEN=your_access_token_here

# === OAuth (for automatic token refresh) ===
JOBBER_CLIENT_ID=your_client_id_here
JOBBER_CLIENT_SECRET=your_client_secret_here
JOBBER_REDIRECT_URI=http://localhost:8080/callback

# === Optional ===
# JOBBER_API_URL=https://api.getjobber.com/api/graphql
# JOBBER_API_VERSION=2025-04-16

# === Headless / VPS mode ===
# JOBBER_NON_INTERACTIVE=1
# JOBBER_MACHINE_MODE=1

# === Logging (never set DEBUG=1 in production — leaks tokens) ===
# LOG_LEVEL=INFO
# DEBUG=false
