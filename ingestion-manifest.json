{
  "name": "aya-ai-kc-ingestion",
  "version": 1,
  "source_root": "/home/aya/.openclaw",
  "corpus": "aya-ai-kc",
  "default_chunking": {
    "strategy": "markdown_heading",
    "target_tokens": 900,
    "min_tokens": 250,
    "max_tokens": 1800,
    "preserve_code_blocks": true,
    "dedupe_by": ["realpath", "sha256"]
  },
  "include": [
    {"glob": "workspaces/agents/main/AGENTS.md", "domain": "identity", "department": "shared", "priority": 1},
    {"glob": "workspaces/agents/main/SOUL.md", "domain": "identity", "department": "shared", "priority": 1},
    {"glob": "workspaces/agents/main/USER.md", "domain": "identity", "department": "shared", "priority": 1},
    {"glob": "workspaces/agents/main/IDENTITY.md", "domain": "identity", "department": "shared", "priority": 1},
    {"glob": "workspaces/agents/main/TOOLS.md", "domain": "runbook", "department": "shared", "priority": 1},
    {"glob": "workspaces/agents/main/TODO/TODO.md", "domain": "runbook", "department": "hq", "priority": 2},
    {"glob": "workspaces/agents/main/memory/*.md", "domain": "memory", "department": "shared", "priority": 2},
    {"glob": "workspaces/shared/kc-vault/**/*.md", "domain": "runbook", "department": "shared", "priority": 2},
    {"glob": "workspaces/shared/docs/**/*.md", "domain": "runbook", "department": "shared", "priority": 2},
    {"glob": "skills/**/*.md", "domain": "skill", "department": "shared", "priority": 2},
    {"glob": "skills/kc-pp-job-costing/**", "domain": "skill", "department": "pp", "priority": 1, "allow_extensions": [".md", ".json", ".py"]},
    {"glob": "skills/jobber-cli-v3-operator/**", "domain": "skill", "department": "ops", "priority": 1, "allow_extensions": [".md", ".json", ".py"]},
    {"glob": "skills/jobber-job-identity/**", "domain": "skill", "department": "ops", "priority": 1, "allow_extensions": [".md", ".json", ".py"]},
    {"glob": "skills/jobber-job-url-lookup/**", "domain": "skill", "department": "ops", "priority": 1, "allow_extensions": [".md", ".json", ".py"]},
    {"glob": "skills/kc-slack-channel-operator/**", "domain": "skill", "department": "ops", "priority": 1, "allow_extensions": [".md", ".json", ".py"]},
    {"glob": "skills/kc-slack-thread-resolver/**", "domain": "skill", "department": "ops", "priority": 1, "allow_extensions": [".md", ".json", ".py"]},
    {"glob": "skills/kc-pp-sync/**", "domain": "skill", "department": "finance", "priority": 1, "allow_extensions": [".md", ".json", ".py"]},
    {"glob": "skills/kc-pp-sync-operator/**", "domain": "skill", "department": "finance", "priority": 1, "allow_extensions": [".md", ".json", ".py"]},
    {"glob": "skills/kc-cloud-ops/**", "domain": "skill", "department": "ops", "priority": 1, "allow_extensions": [".md", ".json", ".py"]},
    {"glob": "workspaces/agents/main/skills/gog/SKILL.md", "domain": "skill", "department": "ops", "priority": 1},
    {"glob": "openclaw.example.json", "domain": "config-template", "department": "shared", "priority": 1},
    {"glob": "plugins/installs.json", "domain": "config-template", "department": "shared", "priority": 2},
    {"glob": "npm/package.json", "domain": "project", "department": "shared", "priority": 2},
    {"glob": "workspaces/shared/Projects/jobber/README.md", "domain": "project", "department": "ops", "priority": 1},
    {"glob": "workspaces/shared/Projects/jobber/CLAUDE.md", "domain": "project", "department": "ops", "priority": 2},
    {"glob": "workspaces/shared/Projects/jobber/SECRETS.md", "domain": "project", "department": "ops", "priority": 2},
    {"glob": "workspaces/shared/Projects/jobber/TODO.md", "domain": "project", "department": "ops", "priority": 2},
    {"glob": "workspaces/shared/Projects/jobber/.env.example", "domain": "config-template", "department": "ops", "priority": 1},
    {"glob": "workspaces/shared/Projects/jobber/.agents/**", "domain": "project", "department": "ops", "priority": 2, "allow_extensions": [".md", ".json", ".toml", ".yaml", ".yml"]},
    {"glob": "workspaces/shared/Projects/jobber/.codex/**", "domain": "project", "department": "ops", "priority": 2, "allow_extensions": [".md", ".json", ".toml", ".yaml", ".yml"]},
    {"glob": "workspaces/shared/Projects/jobber/jobber-cli-v3/**/*.md", "domain": "project", "department": "ops", "priority": 2},
    {"glob": "workspaces/shared/Projects/jobber/oauth/**/*.md", "domain": "project", "department": "ops", "priority": 2},
    {"glob": "workspaces/shared/Projects/jobber/scripts/**/*.md", "domain": "project", "department": "ops", "priority": 2}
  ],
  "exclude": [
    "secrets/**",
    "agents/**",
    "memory/**",
    "tasks/**",
    "cron/runs/**",
    "delivery-queue/**",
    "session-delivery-queue/**",
    "lcm.db*",
    "lcm-files/**",
    "backups/**",
    "workspaces/agents/main/memory/.dreams/**",
    "workspaces/agents/main/memory/dreaming/**",
    "**/node_modules/**",
    "**/.venv/**",
    "**/.cache/**",
    "**/.git/**",
    "**/.env",
    "**/*token*.json",
    "**/*credentials*.json",
    "**/client_secret.json",
    "**/keyring/**"
  ],
  "sensitive_rehydrate_only": [
    "secrets/.env",
    "secrets/jobber_tokens.json",
    "secrets/gog/**",
    "openclaw.json"
  ],
  "systems_of_record": [
    "Jobber",
    "CompanyCam",
    "Slack",
    "Google Sheets",
    "Google Cloud"
  ],
  "validation": [
    "No included file may match an exclude glob.",
    "No secret content may be embedded in the corpus.",
    "Symlinks must be recorded and resolved only if their target remains inside allowed roots.",
    "Every ingested chunk must include source_root, relative_path, domain, department, and priority.",
    "Priority 1 documents must be ingested before priority 2 or 3 documents."
  ]
}
