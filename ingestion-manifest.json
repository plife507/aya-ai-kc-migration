{
  "name": "aya-ai-kc-ingestion",
  "version": 2,
  "source_root": "bundle",
  "corpus": "aya-ai-kc",
  "default_chunking": {
    "strategy": "markdown_heading",
    "target_tokens": 900,
    "min_tokens": 250,
    "max_tokens": 1800,
    "preserve_code_blocks": true,
    "dedupe_by": ["relative_path", "sha256"]
  },
  "include": [
    {"glob": "workspace/kc/AGENTS.md", "domain": "identity", "department": "shared", "priority": 1},
    {"glob": "workspace/kc/SOUL.md", "domain": "identity", "department": "shared", "priority": 1},
    {"glob": "workspace/kc/USER.md", "domain": "identity", "department": "shared", "priority": 1},
    {"glob": "workspace/kc/IDENTITY.md", "domain": "identity", "department": "shared", "priority": 1},
    {"glob": "workspace/kc/TOOLS.md", "domain": "runbook", "department": "shared", "priority": 1},
    {"glob": "workspace/kc/docs/**/*.md", "domain": "runbook", "department": "pp", "priority": 1},
    {"glob": "workspace/kc/memory/*.md", "domain": "memory", "department": "shared", "priority": 2},
    {"glob": "workspace/kc/MEMORY.md", "domain": "memory", "department": "shared", "priority": 2},
    {"glob": "skills/**/*.md", "domain": "skill", "department": "shared", "priority": 2},
    {"glob": "skills/**/*.json", "domain": "skill-reference", "department": "shared", "priority": 2},
    {"glob": "skills/**/*.py", "domain": "skill-script", "department": "shared", "priority": 2},
    {"glob": "skills/**/*.sh", "domain": "skill-script", "department": "shared", "priority": 3},
    {"glob": "skills/**/*.yaml", "domain": "skill-agent", "department": "shared", "priority": 3},
    {"glob": "projects/jobber/**/*.md", "domain": "project", "department": "ops", "priority": 1},
    {"glob": "projects/jobber/jobber-cli-v3/src/**/*.ts", "domain": "project-source", "department": "ops", "priority": 2},
    {"glob": "projects/jobber/jobber-cli-v3/package.json", "domain": "project", "department": "ops", "priority": 1},
    {"glob": "projects/kc-pp-sync/**/*.md", "domain": "project", "department": "finance", "priority": 1},
    {"glob": "projects/kc-pp-sync/src/**/*.ts", "domain": "project-source", "department": "finance", "priority": 2},
    {"glob": "projects/kc-pp-sync/package.json", "domain": "project", "department": "finance", "priority": 1},
    {"glob": "projects/KC-SALES-SYNC/**/*.md", "domain": "project", "department": "sales", "priority": 2},
    {"glob": "projects/KC-SALES-SYNC/src/**/*.ts", "domain": "project-source", "department": "sales", "priority": 3},
    {"glob": "projects/KC-SALES-SYNC/package.json", "domain": "project", "department": "sales", "priority": 2},
    {"glob": "projects/KC-SALES-SYNC-dashboard/**/*.md", "domain": "project", "department": "reporting", "priority": 2},
    {"glob": "projects/KC-SALES-SYNC-dashboard/src/**/*.ts", "domain": "project-source", "department": "reporting", "priority": 3},
    {"glob": "projects/CompanyCam/**/*.md", "domain": "project", "department": "ops", "priority": 2},
    {"glob": "projects/CompanyCam/**/*.ts", "domain": "project-source", "department": "ops", "priority": 3},
    {"glob": "docs/**/*.md", "domain": "runbook", "department": "shared", "priority": 2},
    {"glob": "references/**/*.md", "domain": "runbook", "department": "shared", "priority": 2},
    {"glob": "phases/**/*.md", "domain": "plan", "department": "shared", "priority": 3},
    {"glob": "config-templates/openclaw.redacted.json", "domain": "config-template", "department": "shared", "priority": 1}
  ],
  "exclude": [
    "**/.env",
    "**/.env.local",
    "**/*token*.json",
    "**/*tokens*.json",
    "**/*credentials*.json",
    "**/client_secret*.json",
    "**/keyring/**",
    "**/node_modules/**",
    "**/.venv/**",
    "**/.cache/**",
    "**/.git/**",
    "**/__pycache__/**",
    "**/*.pyc",
    "**/dist/**",
    "**/build/**",
    "**/.next/**"
  ],
  "sensitive_rehydrate_only": [
    "OpenClaw live config secrets",
    "Slack and Telegram credentials",
    "Jobber OAuth credentials and token cache",
    "Google Workspace OAuth credentials",
    "CompanyCam credentials",
    "service env files"
  ],
  "systems_of_record": [
    "Jobber",
    "CompanyCam",
    "Slack",
    "Google Sheets",
    "Google Cloud"
  ],
  "validation": [
    "Run make validate before ingestion.",
    "No included file may match an exclude glob.",
    "No live secret content may be embedded in the corpus.",
    "Every ingested chunk must include source_root, relative_path, domain, department, and priority.",
    "Priority 1 documents must be ingested before priority 2 or 3 documents."
  ]
}
